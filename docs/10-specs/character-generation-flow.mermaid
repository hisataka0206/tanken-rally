%% テクタン キャラ自動生成 システム構成図（In/Out 明示・実ファイル/関数名）
%% 出典コード: src/main.js / src/utils/chargen.js / src/utils/drive.js / src/utils/imagefx.js
%%            src/data/vocab.js / src/data/archetypes.js / src/data/cities.js / gas/Code.gs
flowchart TD

  subgraph SRC["① 読み込むデータ源（ファイル）"]
    direction LR
    TAX["docs/30-research/character-taxonomy/<br/>character_generation_vocab_db.json<br/>（出典: PokeAPI 全1025種の分析）"]
    VOCAB["src/data/vocab.js<br/>6論点語彙DB<br/>motif / atmosphere / expression<br/>type / texture / decoration<br/>（各 app_auto / user_selectable）"]
    ARCH["src/data/archetypes.js<br/>AXIS_BODY（14フォルム）<br/>AXIS_FEATURE（形の特徴）<br/>MOTIF_ARCHETYPE（暫定・要見直し）"]
    CITY["src/data/cities.js<br/>駅名・スポット名"]
    TAX -. ビルド時に変換 .-> VOCAB
  end

  subgraph GATE["② 生成の可否とレア度（main.js / chargen.js）"]
    FINISH["探検おわり<br/>onStartReport()"]
    SUMMARY["buildGenSummary()<br/>In: 実行点 / 写真スポット数 / GPS点 / 距離"]
    ELIG["evaluateEligibility()  chargen.js<br/>Out: 可否 + 距離レア度"]
    RARITY["レア度決定<br/>rarityForDistance()<br/>＋ bumpRarity()（今どこ未使用で1段上げ）<br/>＋ EARLY_BIRD（100人まで=エピック固定）"]
    FINISH --> SUMMARY --> ELIG --> RARITY
  end

  subgraph PICK["③ ユーザー選択（main.js openChargenPickModal）"]
    OFFER["ユーザーに提示（vocab.js の user_selectable）<br/>・タイプ = motif（ねこ / さかな / ほし / ロボット …）<br/>・ふんいき = atmosphere"]
    CHOICE["Out: ユーザー選択 { motif, atmosphere }<br/>未選択の軸は app_auto から自動"]
    OFFER --> CHOICE
  end

  subgraph GEN["④ プロンプト構築と3体生成（chargen.js startGeneration ×3）"]
    VP["makeVocabPicks(overrides=ユーザー選択)  vocab.js<br/>Out: 6論点の語彙セット（候補ごと）"]
    SPOT["pickSpotMotif(スポットカテゴリ)<br/>（motif未選択のとき場所連動で補完）"]
    ARCHFN["archetypeForMotif(motif)  archetypes.js<br/>Out: bodyId ＋ featureId<br/>※ここが乖離の要点（要データ駆動見直し）"]
    PROMPT["buildPrompt()  chargen.js<br/>In: 語彙 + bodyHint + featureHint + レア度 + 駅/スポット<br/>Out: 英語プロンプト（画風は固定DNA）"]
    API["callNanoBananaPro(prompt)  chargen.js<br/>→ drive.generateCharacters()  drive.js<br/>→ GAS generateCharacters  gas/Code.gs<br/>→ Gemini 3 Pro Image（GEMINI_API_KEY）"]
    CUT["cutoutBackground()  imagefx.js<br/>背景透過＋島除去<br/>Out: { url, removedRatio }"]
    VP --> PROMPT
    SPOT --> VP
    CHOICE --> VP
    ARCHFN --> PROMPT
    VP --> ARCHFN
    RARITY --> PROMPT
    PROMPT --> API --> CUT
  end

  subgraph QC["⑤ 品質テスト（chargen.js）"]
    CHECK{"removedRatio ≥ 0.12 ?<br/>（背景が抜けた=有効な個体）"}
    RETRY["欠けたスロットだけ再生成<br/>（初回＋最大2回）"]
    MOCK["それでも不足ならモックで補完<br/>→ 選択肢は必ず3体"]
    CHECK -- NG --> RETRY --> CHECK
    CHECK -- OK ×3 --> READY["3体の候補そろう"]
    RETRY -. 上限超過 .-> MOCK --> READY
  end

  subgraph STORY["⑥ 史実の並行取得（説明文の材料）"]
    FACTS["resolveSpotFacts()<br/>Gemini検索 → Places → Wikipedia"]
  end

  subgraph SHOW["⑦ 提示・選択・保存（main.js / chargen.js）"]
    SIL["renderChargenSilhouettes()<br/>3体の影を提示 → ユーザーが1体選ぶ"]
    BLURB["buildGeneratedStory() / generateCharacterBlurb()<br/>In: 探検データ × 史実 → 融合説明文"]
    SAVE["saveGeneratedCharacter()  chargen.js（図鑑=localStorage）<br/>＋ drive.saveGeneratedCharacter()<br/>→ 画像=Drive / メタ=Sheets"]
    SIL --> BLURB --> SAVE
  end

  %% 全体のIn→Out接続
  SRC --> GATE
  RARITY --> OFFER
  VOCAB --> OFFER
  VOCAB --> VP
  ARCH --> ARCHFN
  CITY --> PROMPT
  READY --> SIL
  FACTS --> BLURB
  CITY -. 史跡スポット .-> FACTS

  classDef file fill:#eef8fe,stroke:#56b6e8,color:#0b3a52;
  classDef api fill:#fff4e5,stroke:#f0a800,color:#5b3a1e;
  classDef gate fill:#f2f7f4,stroke:#0F7A4D,color:#0F7A4D;
  class TAX,VOCAB,ARCH,CITY file;
  class API api;
  class CHECK gate;
